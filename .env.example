# Public site origin used by sitemap, robots, and Open Graph.
# Set this after the first Netlify/Vercel deploy, then again after a custom domain.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional override. Default is https://github.com/dashuaiw046-alt
NEXT_PUBLIC_GITHUB_URL=https://github.com/dashuaiw046-alt
